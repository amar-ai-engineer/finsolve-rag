# Keep the build context small and keep secrets and local state out of the image.
.git/
.github/
.venv/
venv/
.env
.env.*
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.vscode/
.idea/
.DS_Store

# The index is rebuilt inside the image from data/documents/.
data/vectorstore/

# Not needed at runtime.
tests/
eval/
*.md
docker-compose.yml
Dockerfile

# Copy to .env and fill in. Used by `streamlit run app.py`, `uvicorn api.main:app`
# and `docker compose up` (Compose reads .env from this folder automatically).
# Never commit .env.

# Gemini API key for answer generation. Without it, the API's /ask returns 503
# and the Streamlit app needs a key typed into its sidebar.
GOOGLE_API_KEY=your_gemini_api_key_here

# Signing secret for API tokens (JWT). Required by the FastAPI service, at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FINSOLVE_JWT_SECRET=replace_with_a_random_string_of_at_least_32_characters

# Retrieval mode: "vector" (embedding search only) or "hybrid" (vector + BM25
# keyword search, merged with reciprocal rank fusion). Both apply the role filter
# before ranking. See the Evaluation section of the README for how they compare.
FINSOLVE_RETRIEVAL_MODE=vector
